        "jsCode": "// El trigger manda una fila a la vez (la que cambió)\nconst row = $input.first().json;\n\n// Validar que tenga match_id y ambos marcadores\nif (\n  !row.match_id ||\n  row.home_score === undefined || row.home_score === '' ||\n  row.away_score === undefined || row.away_score === ''\n) {\n  return [{ json: { skip: true } }];\n}\n\nconst match = {\n  match_id: String(row.match_id),\n  home_score: Number(row.home_score),\n  away_score: Number(row.away_score),\n  status: row.status && row.status !== 'pending' ? row.status : 'played'\n};\n\nreturn [{ json: { matches: JSON.stringify([match]), skip: false } }];"
